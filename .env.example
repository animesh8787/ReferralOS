# Placeholders only. Copy to .env and fill in; never commit .env.
DATABASE_URL=postgresql+psycopg://referralos:change-me@db:5432/referralos
APP_KEK=            # base64 of 32 random bytes (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
COOKIE_SECURE=false # true behind HTTPS
ADAPTER_MODE=real   # real | mock (mock = offline fixtures)
CORS_ORIGINS=["http://localhost:3000"]
BACKEND_URL=http://localhost:8000
# Optional integrations (leave empty to run fully offline):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_TOKEN=
RESEND_API_KEY=      # system mail (verify/reset); empty = written to data/outbox
MAIL_FROM=ReferralOS <onboarding@resend.dev>
APP_URL=http://localhost:3000
# Production (see docs/DEPLOY.md)
RUN_WORKER=0        # 1 = run the task worker inside the API process
FIREBASE_PROJECT_ID=  # set = sign in only through Firebase Auth
SUPABASE_URL=         # set = uploaded/generated files go to Supabase Storage
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=referralos
